# Copie este arquivo para .env.production.local somente no computador ou no
# ambiente de CI responsavel pelo build. O arquivo .local e ignorado pelo Git.

# O SQL Connect precisa estar implantado antes de ativar esta opcao.
VITE_DATA_CONNECT_ENABLED=true
VITE_USE_DATA_CONNECT_EMULATOR=false
VITE_DATA_CONNECT_EMULATOR_HOST=127.0.0.1
VITE_DATA_CONNECT_EMULATOR_PORT=9399

# As callables usam a regiao southamerica-east1.
VITE_USE_FUNCTIONS_EMULATOR=false
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Ative a IA do navegador somente depois de validar App Check e custos.
VITE_FIREBASE_AI_ENABLED=false
VITE_FIREBASE_AI_MODEL=gemini-3.6-flash

# Chave publica do site reCAPTCHA Enterprise registrado no App Check.
# O build de homologacao/producao nao deve prosseguir com este campo vazio.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Nunca habilite nem defina token debug fora do desenvolvimento local.
VITE_FIREBASE_APPCHECK_DEBUG=false
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
