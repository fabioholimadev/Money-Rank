# Ative somente depois que o serviço SQL Connect estiver implantado.
VITE_DATA_CONNECT_ENABLED=false

# Para desenvolvimento local, esta opção também ativa o SDK.
VITE_USE_DATA_CONNECT_EMULATOR=false
VITE_DATA_CONNECT_EMULATOR_HOST=127.0.0.1
VITE_DATA_CONNECT_EMULATOR_PORT=9399

# Callable functions autoritativas. Quando o emulador do SQL Connect estiver
# ativo, o frontend também usa este emulador automaticamente.
VITE_USE_FUNCTIONS_EMULATOR=false
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Firebase AI Logic: mantenha desativado até registrar o App Check.
VITE_FIREBASE_AI_ENABLED=false
VITE_FIREBASE_AI_MODEL=gemini-3.6-flash

# Chave de site pública do reCAPTCHA Enterprise registrada no App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Use as duas opções abaixo somente no desenvolvimento local.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Token secreto registrado no Firebase. Nunca adicione um valor neste arquivo.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
